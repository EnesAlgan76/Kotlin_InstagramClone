<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent"
    android:layout_height="match_parent"

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="100dp" />

        <TextView
            android:id="@+id/tv_tel2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="NAME AND PASSWORD"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.example.ns.ui.NSEditText
            android:id="@+id/et_frgregister_adsoyad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="24dp"
            android:padding="16dp"
            android:ems="10"
            android:hint="Name Surname"
            app:cornerRadius="12dp"
            app:edgeWidth="1dp"
            android:inputType="textPersonName" />

        <com.example.ns.ui.NSEditText
            android:id="@+id/et_frgregister_kullaniciAdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:padding="16dp"
            android:ems="10"
            app:cornerRadius="12dp"
            app:edgeWidth="1dp"
            android:hint="User Name"
            android:inputType="textPersonName" />

        <com.example.ns.ui.NSEditText
            android:id="@+id/et_frgregister_sifre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:padding="16dp"
            android:ems="10"
            android:hint="Password"
            app:cornerRadius="12dp"
            app:edgeWidth="1dp"
            android:inputType="textPersonName" />

        <Button
            android:id="@+id/btn_ileri_frgregister"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_margin="24dp"
            android:backgroundTint="#3b97f1"
            android:text="Next"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>